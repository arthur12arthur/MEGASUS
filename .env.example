# Exemple de configuration Hyperion — copier en .env et remplir.
# Le fichier .env est ignore par Git (.gitignore) : aucune cle ne versionnee.

# ---- Plateforme / signature ------------------------------------------------
# Nom qui signe chaque envoi, pour identifier l'emetteur dans une boite Gmail
# qui recoit plusieurs systemes Hyperion.
HYPERION_PLATFORM_NAME=Hyperion V1 (GitHub Actions)

# ---- Module 1.1 DataIngestion ---------------------------------------------
# URL du journal hippique officiel du jour (LONAB / PMU'B).
HYPERION_LONAB_URL=
HYPERION_HTTP_TIMEOUT_S=20
HYPERION_HTTP_RETRIES=3
# Marches autorises : evite d'analyser la course d'un autre pays de la zone.
HYPERION_ALLOWED_OPERATORS=LONAB,PMU'B,PMUB
HYPERION_ALLOWED_COUNTRIES=Burkina Faso,BF

# ---- Module 1.2 GeminiManager (optionnel) ---------------------------------
# Plusieurs cles separees par des virgules : rotation automatique en cas de
# quota depasse. Sans cle, le pipeline utilise le parsing direct.
HYPERION_GEMINI_KEYS=
HYPERION_GEMINI_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite,gemini-1.5-flash

# ---- Module 1.5 DataFilter ------------------------------------------------
HYPERION_FILTER_THRESHOLD=3
HYPERION_FILTER_MIN_GROUP=5
HYPERION_FILTER_FAVOURITES=5

# ---- Module 1.7 ConsensusInterne ------------------------------------------
HYPERION_MC_SEEDS=11,23,37,51,73
HYPERION_MC_SIMULATIONS=10000
# Concentration calibree par le labo Ouroboros (protocole glissant).
HYPERION_MC_CONCENTRATION=0.5

# ---- Module 1.9 ExternalConsensus -----------------------------------------
HYPERION_EXTERNAL_MIN_SOURCES=3

# ---- Module 1.12 Delivery : Telegram (gratuit) ----------------------------
HYPERION_TELEGRAM_TOKEN=
HYPERION_TELEGRAM_CHAT_ID=

# ---- Module 1.12 Delivery : email Gmail (gratuit, mot de passe d'application)
HYPERION_SMTP_HOST=smtp.gmail.com
HYPERION_SMTP_PORT=587
HYPERION_SMTP_USER=
HYPERION_SMTP_PASSWORD=
HYPERION_MAIL_FROM=
HYPERION_MAIL_TO=

# ---- Mode -----------------------------------------------------------------
# true = rien n'est envoye (tests).
HYPERION_DRY_RUN=false
# true = un humain valide avant l'envoi ; false = checklist d'auto-validation.
HYPERION_HUMAN_PRESENT=true
